{
  "name": "grush-sdk-js",
  "version": "0.12.0",
  "private": true,
  "description": "GameRush GameAPI for plain HTML/JavaScript games",
  "type": "module",
  "main": "./grush-sdk.mjs",
  "module": "./grush-sdk.mjs",
  "browser": "./grush-sdk.js",
  "types": "./grush-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./grush-sdk.d.ts",
      "import": "./grush-sdk.mjs",
      "default": "./grush-sdk.js"
    }
  },
  "files": [
    "grush-sdk.js",
    "grush-sdk.mjs",
    "grush-sdk.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/build.mjs --check && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
